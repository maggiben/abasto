# Copy to backend/.env and adjust.
# Hybrid dev (USB printing on Mac/Windows): Postgres in Docker only — from repo root:
#   docker compose up -d postgres
# Then here: pip install -e ".[printer]" or ".[printer_escpos]" if PRINTER_PREFER_ESCPOS=true,
#   alembic upgrade head && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000
# Frontend (separate terminal): cd ../frontend && npm run dev  (use .env.local with NEXT_PUBLIC_API_URL)
# Admin product/inventory APIs require a JWT for a user with is_staff=true (set in DB after register).
DATABASE_URL=postgresql+asyncpg://abasto:abasto@localhost:5432/abasto
JWT_SECRET=change-me-to-a-long-random-string
DEBUG=false
# Default sales tax % for POST /pos/checkout when tax_rate_percent is omitted (e.g. 10.5).
DEFAULT_TAX_RATE_PERCENT=0

# Thermal USB printer (same machine as API).
# Install pyusb only (like root print.py):  pip install -e ".[printer]"
# Or pyusb + python-escpos (like easy.py): pip install -e ".[printer_escpos]"
# PRINTER_ENABLED=true
# PRINTER_USB_VENDOR=0x0483
# PRINTER_USB_PRODUCT=0x070B
# PRINTER_PROFILE=XP-58
# PRINTER_PREFER_ESCPOS=false
# RECEIPT_STORE_NAME=ABASTO
