# Copy to frontend/.env.local and adjust. Next.js loads .env.local automatically.

# Base URL of the backend API (browsers call this host, not Docker service names).
NEXT_PUBLIC_API_URL=http://localhost:8000

# POS checkout: VAT/sales tax percentage sent to POST /pos/checkout as tax_rate_percent.
# Decimals: dot or comma (e.g. 10.5 or 10,5). If unset, the POS client defaults to 21; if empty, tax is omitted and the API uses DEFAULT_TAX_RATE_PERCENT.
NEXT_PUBLIC_POS_TAX_PERCENT=0
